# Copia este archivo como .env y rellena los valores (el .env NO se sube a GitHub)
# En Render estas mismas variables se ponen en el panel del servicio -> Environment

# Conexión a Supabase: Connect -> Session pooler -> URI (cambia [YOUR-PASSWORD] por la contraseña de la base de datos)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Clave secreta para firmar los tokens JWT (una cadena larga y aleatoria)
JWT_SECRET=pon-aqui-una-clave-larga-y-aleatoria
